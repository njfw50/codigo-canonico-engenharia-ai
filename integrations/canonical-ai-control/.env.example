# Do NOT commit the real keys. Generate random tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# User key = ChatGPT plugin API-key auth. Agent adapter key = server-to-server secret, NEVER share with an LLM.
CANONICAL_USERS_JSON={"demo":"REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS"}
CANONICAL_ADAPTERS_JSON={"demo:muse":"REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_24_CHARS"}
CANONICAL_DATA_DIR=./.canonical-data
PORT=3000
